# Portfolio Environment Variables Example
# Duplicate this file to .env and adjust values for your environment.

# Flask Application Secret Key (Change this to a strong random string in production)
SECRET_KEY=dev-secret-key-change-in-production

# Flask Environment mode ('development' or 'production')
FLASK_ENV=development

# Database Connection URL:
# 1. DEV MODE (Default): Leave DATABASE_URL empty or unset to automatically use local SQLite (portfolio_dev.db)
# DATABASE_URL=

# 2. Local MySQL:
# DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/portfolio_db

# 3. Production MySQL / TiDB Cloud Starter (Free MySQL-compatible tier):
# DATABASE_URL=mysql+pymysql://username:password@gateway.tidbcloud.com:4000/portfolio_db?ssl_verify_cert=true
